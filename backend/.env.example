# Copiar a ".env" (mismo directorio) y completar DB_PASSWORD y JWT_SECRET.
# La contraseña real se pide al equipo por mensaje privado; este archivo se sube al repo, ".env" no.

# --- Opcion A: conexion directa (requiere IPv6 en tu red) ---
DB_URL=jdbc:postgresql://db.gmymbsjmyjwtkcyggtyg.supabase.co:5432/postgres
DB_USER=postgres

# --- Opcion B: Session pooler (IPv4). Reemplazar <host-del-pooler> con el que muestra Supabase > Connect ---
# DB_URL=jdbc:postgresql://<host-del-pooler>:5432/postgres
# DB_USER=postgres.gmymbsjmyjwtkcyggtyg

DB_PASSWORD=

# Clave para firmar los JWT: cualquier cadena larga y aleatoria (min. 32 caracteres)
JWT_SECRET=

JWT_EXPIRATION_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Puerto local si 8080 esta ocupado (ej. Docker)
# PORT=9090
